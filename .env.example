# ============================================
# KisanMind — Environment Variables
# ============================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ============================================

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_REGION=asia-south1
EE_PROJECT=your-ee-project

# --- Google Maps + Weather API ---
GOOGLE_MAPS_API_KEY=your-key

# --- Gemini AI ---
GEMINI_API_KEY=your-key

# --- External APIs ---
AGMARKNET_API_KEY=your-key

# --- Open satellite/agro-climate data (NO KEY REQUIRED) ---
# NASA POWER (power.larc.nasa.gov) and Open-Meteo (open-meteo.com) provide live
# evapotranspiration, soil moisture, solar radiation and VPD with no key. Nothing to set.

# --- Copernicus Data Space Ecosystem (OPTIONAL — direct Sentinel-2 AND Sentinel-3, no GEE) ---
# One free OAuth client at https://dataspace.copernicus.eu unlocks BOTH Sentinel-2 (14 indices)
# and Sentinel-3 OLCI (OTCI chlorophyll + daily NDVI gap-fill). Leave blank to skip.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- NASA Earthdata (OPTIONAL — GLDAS soil moisture + ET, independent cross-validation source) ---
# Free token at https://urs.earthdata.nasa.gov (Profile -> Generate Token). Leave blank to skip.
EARTHDATA_TOKEN=

# --- Transport economics (OPTIONAL) ---
# Diesel price (Rs/litre) for the real transport-fare model. Defaults to ~90 if unset.
DIESEL_PRICE_PER_L=

# --- Storage ---
GCS_CACHE_BUCKET=kisanmind-cache

# --- Base URL ---
BASE_URL=https://kisanmind.dmj.one

# Optional: Twilio (for voice calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Earth Engine service account
EE_SERVICE_KEY_JSON=
EE_SERVICE_KEY_PATH=
